<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>arch.managment</artifactId>
    <groupId>consulo</groupId>
    <version>3-SNAPSHOT</version>
    <relativePath>pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <groupId>consulo.internal</groupId>
  <artifactId>compiler.apt.scala</artifactId>
  <version>4.1</version>
  <build>
    <sourceDirectory>src/main/scala</sourceDirectory>
    <testSourceDirectory>src/test/scala</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
        <version>4.10.0</version>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>testCompile</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <scalaVersion>${scala.version}</scalaVersion>
          <args>
            <arg>-deprecation</arg>
            <arg>-feature</arg>
            <arg>-java-output-version</arg>
            <arg>25</arg>
          </args>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <artifactSet>
                <includes>
                  <include>${project.groupId}:compiler.apt.shared</include>
                  <include>${project.groupId}:compiler.apt.scala.generation</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <snapshots>
        <updatePolicy>interval:60</updatePolicy>
      </snapshots>
      <id>consulo</id>
      <url>https://maven.consulo.dev/repository/snapshots/</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala3-compiler_3</artifactId>
      <version>3.9.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.3</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-api</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-params</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>1.10.3</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-platform-engine</artifactId>
          <groupId>org.junit.platform</groupId>
        </exclusion>
        <exclusion>
          <artifactId>apiguardian-api</artifactId>
          <groupId>org.apiguardian</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>consulo</groupId>
      <artifactId>consulo-annotation</artifactId>
      <version>3-SNAPSHOT</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>nullaway-annotations</artifactId>
          <groupId>com.uber.nullaway</groupId>
        </exclusion>
        <exclusion>
          <artifactId>jakarta.annotation-api</artifactId>
          <groupId>jakarta.annotation</groupId>
        </exclusion>
        <exclusion>
          <artifactId>jspecify</artifactId>
          <groupId>org.jspecify</groupId>
        </exclusion>
        <exclusion>
          <artifactId>apiguardian-api</artifactId>
          <groupId>org.apiguardian</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>consulo</groupId>
      <artifactId>consulo-component-api</artifactId>
      <version>3-SNAPSHOT</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>consulo-container-api</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-disposer-api</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-platform-api</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-ui-api</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-logging-api</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-util-dataholder</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-util-concurrent-coroutine</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-util-xml-serializer</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-util-io</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-util-jdom</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>dsl-json</artifactId>
          <groupId>consulo.internal.com.dslplatform</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>consulo</groupId>
      <artifactId>consulo-localize-api</artifactId>
      <version>3-SNAPSHOT</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>consulo-util-lang</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
        <exclusion>
          <artifactId>consulo-disposer-api</artifactId>
          <groupId>consulo</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <version>2.0.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <properties>
    <scala.version>3.9.0</scala.version>
  </properties>
</project>
